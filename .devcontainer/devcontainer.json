{
  "name": "Loblaw Bio - miraclib cell-count analysis",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-bookworm",
  "postCreateCommand": "make setup",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
